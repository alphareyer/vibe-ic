# MUTATION ARM — issue2177: produce_live names three outcomes and returns two.
#
# WHAT THIS RE-PLANTS. The defect is not a missing feature; it is a value the
# code COMPUTES and then throws away. `produce_live` decides `unmeasured` from
# the pair (rc==2, the flow's own vacuity token) and this patch passes `False`
# in its place, and `audit_step` collects the unmeasured rows and this patch
# returns `[]` instead. That is the pre-fix shape in its own words — "the
# message knows; the control flow does not" — reached by the smallest edit that
# restores it, so what goes red is the property, not a signature.
#
# WHY THE PATCH TOUCHES A TEST FILE. `produce_live` IS in the test module; the
# subject and the suite are one file, which is why this branch is tests-only
# and why the falsifier's R arm (main sources + the branch's tests) cannot
# differ from G. This patch applies ON TOP of the branch's file in tree M.
#
# WHAT GOES RED, MEASURED on 8HD-8 at main e777ed7fe with NO corpus bound:
#   test_d3_a_measured_absence_still_fails_beside_an_unmeasured_entry  FAILED
#   test_d3_only_a_disclosed_rc2_is_unmeasured                         3 SKIPPED
# The three rc-2 arms need a live-produced entry with a run root, so they skip
# where the corpus is unbound; the audit_step arm needs neither and reddens on
# any host. One RED is what the arm requires, and it is host-independent.
--- a/vibe-ic-marketplace/plugins/vibe-ic/programs/tests/test_matrix_d3_outputs_produced.py
+++ b/vibe-ic-marketplace/plugins/vibe-ic/programs/tests/test_matrix_d3_outputs_produced.py
@@ -1860,13 +1860,13 @@
                 if proc.returncode == 2 and disclosed_vacuous else ""
             )
             return LiveProduction(False, (
                 f"ran `{program} {' '.join(argv)}` in a copy of {label!r} "
                 f"(rc={proc.returncode}) and {writes} was NOT written; "
                 f"last output: {tail}{unmeasured}"
-            ), bool(unmeasured))
+            ), False)
         size = target.stat().st_size
         if size <= 0:
             return LiveProduction(False, (
                 f"ran `{program} {' '.join(argv)}` in a copy of {label!r} and "
                 f"{writes} landed at 0 bytes — a zero-byte artefact is not a "
                 f"produced artefact"
@@ -2622,15 +2622,13 @@
         else:
             v = check_entry(step_id, entry, recorded[entry])
         details.append(f"[{v.mode}] {entry!r} -> {v.detail}")
         if not v.produced:
             row = f"{entry!r}: {v.detail}"
             missing.append(row)
-            if v.unmeasured:
-                unmeasured.append(row)
-    return missing, details, unmeasured
+    return missing, details, []
 
 
