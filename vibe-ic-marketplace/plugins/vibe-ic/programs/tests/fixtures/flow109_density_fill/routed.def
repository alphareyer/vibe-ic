VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fill_smoke ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 core 0 0 N DO 20 BY 1 STEP 1000 0 ;
ROW ROW_1 core 0 19000 N DO 20 BY 1 STEP 1000 0 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 2 ;
- in + NET sig + DIRECTION INPUT + USE SIGNAL + LAYER M1 ( -100 -100 ) ( 100 100 ) + FIXED ( 1000 10000 ) N ;
- out + NET sig + DIRECTION OUTPUT + USE SIGNAL + LAYER M1 ( -100 -100 ) ( 100 100 ) + FIXED ( 19000 10000 ) N ;
END PINS
NETS 1 ;
- sig ( PIN in ) ( PIN out ) + ROUTED M1 ( 1000 10000 ) ( 19000 10000 ) ;
END NETS
END DESIGN
