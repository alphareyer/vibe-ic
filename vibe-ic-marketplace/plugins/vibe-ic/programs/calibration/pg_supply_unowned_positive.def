VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN cal_pg ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 80000 80000 ) ;
ROW ROW_0 GF018hv5v_mcu_sc7 10080 15680 N DO 53 BY 1 STEP 1120 0 ;
ROW ROW_1 GF018hv5v_mcu_sc7 10080 23520 FS DO 53 BY 1 STEP 1120 0 ;
ROW ROW_2 GF018hv5v_mcu_sc7 10080 31360 N DO 53 BY 1 STEP 1120 0 ;
ROW ROW_3 GF018hv5v_mcu_sc7 10080 39200 FS DO 53 BY 1 STEP 1120 0 ;
ROW ROW_4 GF018hv5v_mcu_sc7 10080 47040 N DO 53 BY 1 STEP 1120 0 ;
ROW ROW_5 GF018hv5v_mcu_sc7 10080 54880 FS DO 53 BY 1 STEP 1120 0 ;
COMPONENTS 2 ;
    - hold1 gf180mcu_fd_sc_mcu7t5v0__buf_1 + PLACED ( 40000 20000 ) N ;
    - u0 gf180mcu_fd_sc_mcu7t5v0__buf_1 + PLACED ( 20000 20000 ) N ;
END COMPONENTS
PINS 2 ;
    - a + NET a + DIRECTION INPUT + USE SIGNAL ;
    - y + NET y + DIRECTION OUTPUT + USE SIGNAL ;
END PINS
SPECIALNETS 2 ;
    - VDD ( u0 VNW ) ( u0 VDD ) + USE POWER ;
    - VSS ( u0 VPW ) ( u0 VSS ) + USE GROUND ;
END SPECIALNETS
NETS 2 ;
    - a ( PIN a ) ( u0 I ) + USE SIGNAL ;
    - y ( PIN y ) ( u0 Z ) + USE SIGNAL ;
END NETS
END DESIGN
